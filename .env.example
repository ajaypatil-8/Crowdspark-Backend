# Crowdspark-Backend/.env.example
# Feature #29 — Docker + docker-compose
#
# Copy this file to .env in the same folder, then fill in every REQUIRED
# value before running `docker compose up`. Everything else already has a
# safe local-dev default in application.properties / docker-compose.yml —
# only override it if you need something different.
#
# NOTE: application-example.yml (also in this folder) is a stale leftover
# from before these variables existed — its names (DB_URL/PAYMENTS_WEBHOOK_
# SECRET/JWT_ACCESS_EXP) don't match application.properties anymore. Delete
# it; this file is the current, accurate one.

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=                          # REQUIRED — pick any strong password for local Postgres

# ── JWT (REQUIRED) ────────────────────────────────────────────────────────────
# Must be at least 32 characters (256 bits) or the app refuses to start —
# jjwt's Keys.hmacShaKeyFor() throws WeakKeyException on anything shorter.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# ── Cloudinary (REQUIRED for image/video uploads) ────────────────────────────
# https://console.cloudinary.com/ → Dashboard
CLOUDINARY_CLOUD_NAME=dutsfk8u6
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Mail — Brevo SMTP relay (REQUIRED for OTP/notification emails) ───────────
# MAIL_USERNAME is the SMTP login from Brevo -> Settings -> SMTP & API
# (format: xxxxxx@smtp-brevo.com) -- NOT your Brevo account email.
# MAIL_PASSWORD is the SMTP key generated on that same page, not your Brevo
# account password. MAIL_FROM_ADDRESS is the visible sender: it must be a
# verified sender (or on a verified/authenticated domain) under Senders,
# Domains & Dedicated IPs in Brevo, and can be a completely different
# address from MAIL_USERNAME.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# ── Google OAuth2 login (REQUIRED — client secret only) ──────────────────────
# console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=715290460775-tag6f8omjgp6g71i6hu3ndda451erl5s.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# ── GitHub OAuth2 login (REQUIRED — client secret only) ──────────────────────
# github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=Ov23lirEpx9uZSPuGCeb
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8080/crowdspark/login/oauth2/code/github

# ── Frontend origin (used for CORS + email links) ────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Razorpay (REQUIRED — key secret only) ────────────────────────────────────
# dashboard.razorpay.com → Settings → API Keys. Use TEST mode keys for local
# dev (rzp_test_...) — never put LIVE keys in a shared/committed .env.
RAZORPAY_KEY_ID=rzp_test_ScEr5x5BTRh6iN
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_NUMBER=

# ── Firebase Cloud Messaging (optional — push notifications) ─────────────────
# Leave unset to run with push notifications disabled (FirebaseConfig logs a
# warning and degrades gracefully). To enable: generate a NEW service-account
# key in the Firebase console (console.firebase.google.com → Project Settings
# → Service Accounts → Generate new private key), save it OUTSIDE this repo,
# e.g. ./secrets/firebase-service-account.json, then uncomment the matching
# volume mount in docker-compose.yml and set:
# FIREBASE_SERVICE_ACCOUNT_PATH=file:/app/firebase-service-account.json

# ── Groq API (optional — powers AI creator tools, Feature #39+) ──────────────
# Genuinely free tier: console.groq.com → sign in with email or Google →
# API Keys → create key. No credit card. Leave unset to run with AI drafting
# disabled (AiServiceImpl returns a clean 503 instead of failing startup —
# same graceful-degrade pattern as the Firebase block above).
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.6-27b
# AI_DESCRIPTION_DAILY_LIMIT=25

# ── Monitoring (optional — only used by docker-compose.monitoring.yml) ───────
# Login for the Grafana UI at http://localhost:3001. Change this from the
# default before running anywhere other than your own machine.
GRAFANA_ADMIN_PASSWORD=admin

# ── Connection pool sizing (optional) ─────────────────────────────────────────
# All have sensible defaults already (smaller in application.properties for
# local dev, larger in application-prod.properties when SPRING_PROFILES_
# ACTIVE=prod) — only set these if you need to override those defaults.
# DB_POOL_MAX=20
# DB_POOL_MIN_IDLE=10
# REDIS_POOL_MAX_ACTIVE=20
# REDIS_POOL_MAX_IDLE=20
# REDIS_POOL_MIN_IDLE=5

